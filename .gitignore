# ==========================================
# LibraSys root .gitignore (Spring Boot & React)
# ==========================================

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*.tmp
.DS_Store
Thumbs.db

# Maven / Spring Boot Backend
backend/target/
backend/*.jar
backend/*.war
backend/*.zip
backend/*.tar.gz
backend/dependency-reduced-pom.xml
backend/.mvn/wrapper/maven-wrapper.jar
backend/mvnw
backend/mvnw.cmd

# Node / React Frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs and system artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Crash dumps
drwtsn32.log
ntuser.dat*
